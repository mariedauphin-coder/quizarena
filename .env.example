# Copy to .env and fill in for production.

# Port the server listens on (most hosts set this automatically).
PORT=3000

# Set to "production" so auth cookies are marked Secure (HTTPS only).
NODE_ENV=production

# REQUIRED IN PRODUCTION: a long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file is stored. On hosts with a persistent
# disk (e.g. Render), point this at the mounted volume so data survives
# restarts and deploys, e.g. /var/data
DATA_DIR=./data
